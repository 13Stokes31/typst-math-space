{
  "name": "typst-math-space",
  "displayName": "Typst Math Space",
  "description": "In .typ files: typing a space inside $$ places the cursor between two spaces, ready to write a math expression.",
  "version": "0.0.2",
  "publisher": "13Stokes31",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/13Stokes31/typst-math-space"
  },
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": ["onLanguage:typst"],
  "main": "./out/extension.js",
  "contributes": {},
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.107.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.48.1",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
